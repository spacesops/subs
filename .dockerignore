# The prover image builds from the repo root, so keep the context small —
# everything here is either rebuilt inside the image or irrelevant to it.
.git
.github
.idea
.claude
.vscode
target
**/target

# Local operator state, never part of an image.
data
testrig-data
datamad
*.bin
*.priv
*.subs
*.subs.c
*.sdb

# Secrets and local notes (keep README for image docs if needed).
.env
.env.*
NOTES.md
*.md
!README.md

.DS_Store
**/.DS_Store
screenshot.png
LICENSE
